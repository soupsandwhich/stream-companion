 // ========== TWITCH API ROUTES ==========
+// Channel point rewards (needs channel:read:redemptions, already requested at login)
+app.get('/api/twitch/rewards', async (req, res) => {
+  try {
+    if (!twitchState.apiClient || !twitchState.userId) {
+      return res.status(503).json({ error: 'Twitch not connected', rewards: [] });
+    }
+    const rewards = await twitchState.apiClient.channelPoints.getCustomRewards(twitchState.userId);
+    res.json({
+      rewards: rewards.map(r => ({ id: r.id, title: r.title, cost: r.cost, enabled: r.isEnabled }))
+    });
+  } catch (e) {
+    console.error('Failed to load channel point rewards:', e.message);
+    res.status(502).json({ error: e.message, rewards: [] });
+  }
+});
