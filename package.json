{
  "name": "stream-companion",
  "version": "1.3.2",
  "description": "Stream Companion for Streamerbot",
  "main": "src/main/index.js",
  "author": "Kyle",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@twurple/api": "^8.1.4",
    "@twurple/auth": "^8.1.4",
    "@twurple/chat": "^8.1.4",
    "@twurple/eventsub-ws": "^8.1.4",
    "chokidar": "^3.5.3",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "tmi.js": "^1.8.5",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.soupymediagroup.streamcompanion",
    "productName": "Stream Companion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "src/overlays",
        "to": "overlays"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": {
      "provider": "generic",
      "url": "https://stream.soupymediagroup.com/app"
    }
  }
}
